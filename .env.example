# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
CLAUDE_API_KEY="MY_CLAUDE_API_KEY"
MISTRAL_API_KEY="MY_MISTRAL_API_KEY"
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"
NVIDIA_API_URL="YOUR_NVIDIA_API_URL"
NVIDIA_MODEL_NAME="YOUR_NVIDIA_MODEL_NAME"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration
# Get these from your Supabase project settings > API
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Razorpay Configuration
# Get these from your Razorpay Dashboard > Settings > API Keys
VITE_RAZORPAY_KEY_ID="YOUR_RAZORPAY_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"

# PostHog Configuration
# PostHog project token and host for analytics. Get the token from
# your PostHog project settings > Project API Key.
POSTHOG_PROJECT_TOKEN="YOUR_POSTHOG_PROJECT_TOKEN"
POSTHOG_HOST="https://us.i.posthog.com"
