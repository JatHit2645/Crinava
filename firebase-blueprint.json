{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User's game stats and coin balance",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "User's UID" },
        "email": { "type": "string", "format": "email", "description": "User's email" },
        "cricket_iq": { "type": "integer", "description": "User's Cricket IQ score" },
        "crinava_coins": { "type": "integer", "description": "User's Crinava Coin balance" },
        "updated_at": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["id", "email", "cricket_iq", "crinava_coins"]
    }
  },
  "firestore": {
    "/profiles/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document"
    }
  }
}
