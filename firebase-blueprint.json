{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User's game stats and coin balance",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "User's UID" },
        "email": { "type": "string", "format": "email", "description": "User's email" },
        "username": { "type": "string", "description": "Unique username" },
        "cricket_iq": { "type": "integer", "description": "User's Cricket IQ score" },
        "crinava_coins": { "type": "integer", "description": "User's Crinava Coin balance" },
        "photoURL": { "type": "string", "description": "User's profile picture URL (base64)" },
        "career_path": { "type": "string", "description": "User's current career path stage" },
        "expertise_badge": { "type": "string", "description": "User's current expertise badge" },
        "professional_comparison": { "type": "object", "description": "Comparison stats with pros" },
        "updated_at": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["id", "email", "username", "cricket_iq", "crinava_coins"]
    },
    "Username": {
      "title": "Username Mapping",
      "description": "Mapping of username to UID for uniqueness",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "UID associated with the username" }
      },
      "required": ["uid"]
    }
  },
  "firestore": {
    "/profiles/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document"
    },
    "/usernames/{username}": {
      "schema": "Username",
      "description": "Username uniqueness mapping"
    }
  }
}
